### RPC Configuration
ALCHEMY_KEY=

### Account Configuration  
# account name of the account in the forge vault
ACCOUNT=your-account-name
# selected address of the account from the forge vault
SENDER=0xYourSenderAddressHere

### Contract verification
# well defined chain ID i.e. 1 or 17000
CHAIN_ID=chain-id
# Etherscan v2 API URL
ETHERSCAN_API_URL=https://api.etherscan.io/v2/api
# etherscan API key
ETHERSCAN_API_KEY=your-etherscan-api-key

# IPFS upload only - JWT with public file write permission and pinFileToIPFS legacy permission
PINATA_JWT=
