{
    "image": "mcr.microsoft.com/devcontainers/rust:1-1-bullseye",
    "features": {
        "ghcr.io/devcontainers/features/node:1": {}
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "JuanBlanco.solidity"
            ],
            "settings": {
                "solidity.formatter": "forge"
            }
        }
    },
    "postCreateCommand": [
        "/bin/bash",
        ".devcontainer/postCreateInstall.sh"
    ]
}