{
  "name": "alto-v1",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "prepare": "husky",
    "lint": "forge fmt --check",
    "clean": "forge clean",
    "test": "forge test",
    "test:simulations": "FOUNDRY_PROFILE=simulations forge test -vvv",
    "coverage:lending": "rm -rf lcov.info coverage && FOUNDRY_PROFILE=market forge coverage --no-match-coverage '(script|test|contracts/deployments|contracts/tokens|contracts/utils/OFT.sol|contracts/utils/LeverageABIHelper.sol)' --report lcov && sleep 2 && genhtml ./lcov.info -o coverage --branch-coverage --rc derive_function_end_line=0 ",
    "coverage:open": "npx -y open-cli coverage/index.html",
    "coverage:server": "npx -y http-server coverage",
    "upload:emergency-controller": "node tools/emergency-controller/upload.mjs",
    "deploy:testnet": "./_scripts/deployment/alto-testnet.sh",
    "deploy:1": "./_scripts/deployment/alto-1.sh",
    "verify:testnet": "./_scripts/deployment/verify-testnet.sh"
  },
  "lint-staged": {
    "**/*.sol": "forge fmt"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "@layerzerolabs/oft-evm": "3.1.4",
    "@layerzerolabs/oapp-evm": "0.3.2",
    "@layerzerolabs/lz-evm-protocol-v2": "3.0.94",
    "@layerzerolabs/test-devtools-evm-foundry": "6.0.3",
    "@layerzerolabs/lz-evm-messagelib-v2": "3.0.94",
    "@layerzerolabs/lz-evm-v1-0.7": "3.0.94",
    "solidity-bytes-utils": "0.8.3",
    "husky": "9.1.7",
    "lint-staged": "16.2.7"
  }
}
