{
  "name": "tapioca-bar",
  "license": "MIT",
  "scripts": {
    "lint:ts": "eslint . --fix",
    "lint:sol": "prettier --write \"./contracts/**/*.sol\" && solhint \"./contracts/**/*.sol\" --fix",
    "lint": "npm run lint:ts && npm run lint:sol",
    "clean": "rm -rf ./cache && rm -rf ./gen",
    "test": "npx hardhat test",
    "test:arb": "NODE_ENV=arbitrum hardhat test",
    "test:main": "NODE_ENV=mainnet hardhat test",
    "test:deployments": "forge test --match-path  'test/deployments/*' -vvv",
    "prepare": "husky install",
    "coverage:twtap": "FOUNDRY_PROFILE=twTap forge coverage --match-path 'test/tap-token/unit/options/TWLBase/**/*.sol' --ir-minimum  --report lcov && genhtml lcov.info -o report --branch-coverage",
    "coverage:usdo": "FOUNDRY_PROFILE=usdo forge coverage --match-path 'test/bar/**/*.sol' --ir-minimum  --report lcov && genhtml lcov.info -o report --branch-coverage",
    "coverage": "forge coverage --ir-minimum --report lcov && genhtml lcov.info -o report --branch-coverage",
    "test:twtap": "FOUNDRY_PROFILE=twTap forge test --match-path 'test/tap-token/unit/options/TWLBase/**/*.sol'"
  },
  "devDependencies": {
    "@layerzerolabs/lz-evm-messagelib-v2": "2.3.6",
    "@layerzerolabs/lz-evm-oapp-v2": "^2.3.6",
    "@layerzerolabs/lz-evm-protocol-v2": "2.3.6",
    "@swc/core": "^1.5.24",
    "dotenv": "^10.0.0",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^4.0.0",
    "hardhat-deploy": "^0.12.4",
    "prb-math": "^2.4.1",
    "prettier": "^2.5.1",
    "prettier-plugin-solidity": "^1.1.3",
    "solhint": "^3.3.6",
    "solidity-math": "^0.1.0"
  },
  "dependencies": {
    "@layerzerolabs/lz-v2-utilities": "2.3.6",
    "@uniswap/v3-core": "^1.0.1",
    "husky": "^8.0.1"
  }
}