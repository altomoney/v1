RemoveSupplyTest
├── given market is paused
│   └── it should revert
├── given both assets and shares are provided
│   └── it should revert
├── given receiver is zero address
│   └── it should revert
├── given sender is not authorized for onBehalf
│   └── it should revert
├── given assets is provided
│   ├── when assets is zero
│   │   └── it should revert
│   └── when assets is greater than zero
│       ├── when user has insufficient supply
│       │   └── it should revert
│       └── when user has sufficient supply
│           └── it should remove supply and burn shares
└── given shares is provided
    ├── when shares is zero
    │   └── it should revert
    └── when shares is greater than zero
        ├── when user has insufficient supply
        │   └── it should revert
        └── when user has sufficient supply
            └── it should remove supply and burn shares 